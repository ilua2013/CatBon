    - target: {fileID: 4680492978790400190, guid: ca044292c12aa5e4b9e54bbd6a1cd515, type: 3}
      propertyPath: m_Text
      value: "\u041D\u0435 \u0441\u0430\u0434\u0438\u0442\u0435\u0441\u044C \u0438
        \u043D\u0435 \u043E\u043F\u0438\u0440\u0430\u0439\u0442\u0435\u0441\u044C
        \u043D\u0430 \u043E\u0431\u044A\u0435\u043A\u0442\u044B \u0432 \u0432\u0438\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u043E\u0439
        \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438. \u041D\u0435\u0437\u0430\u043C\u0435\u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        \u0441\u043D\u0438\u043C\u0438\u0442\u0435 \u0448\u043B\u0435\u043C, \u0435\u0441\u043B\u0438
        \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435
        \u0434\u0438\u0441\u043A\u043E\u043C\u0444\u043E\u0440\u0442. \u0421\u0434\u0435\u043B\u0430\u0439\u0442\u0435
        \u043F\u0435\u0440\u0435\u0440\u044B\u0432 \u0447\u0435\u0440\u0435\u0437
        30 \u043C\u0438\u043D\u0443\u0442."
      objectReference: {fileID: 0}
    - target: {fileID: 4680492978790400190, guid: ca044292c12aa5e4b9e54bbd6a1cd515, type: 3}
      propertyPath: m_FontData.m_Font
