--- !u!114 &1257849582
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1257849580}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 50a36eba57ae8d447ac60467ec2693ca, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  main: {fileID: 0}
  startReactions:
  - name: UI_On
    type: 1
    reaction: {fileID: 739654644}
    nameCommonSystem: 
    value: 1
  endReactions: []
  waitedAction: right
  errorText: "\u0412\u043E \u0438\u0437\u0431\u0435\u0436\u0430\u043D\u0438\u0435
    \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0432\u0440\u0435\u0434\u043D\u044B\u0445
    \u0438 \u043E\u043F\u0430\u0441\u043D\u044B\u0445 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
    \u0444\u0430\u043A\u0442\u043E\u0440\u043E\u0432 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043B\u0438\u0437\u043D\u0438\u043A
    \u043E\u0431\u044F\u0437\u0430\u043D \u0431\u044B\u0442\u044C \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D
    \u0441\u043F\u0435\u0446\u043E\u0434\u0435\u0436\u0434\u043E\u0439 \u0438 \u0421\u0418\u0417
    \u0432 \u0441\u043E\u0441\u0442\u0430\u0432\u0435: 1. \u043A\u043E\u0441\u0442\u044E\u043C
    \u0434\u043B\u044F \u0437\u0430\u0449\u0438\u0442\u044B \u043E\u0442 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u043E\u0432
    \u043A\u0438\u0441\u043B\u043E\u0442 \u0438 \u0449\u0435\u043B\u043E\u0447\u0435\u0439;
    2. \u0444\u0430\u0440\u0442\u0443\u043A \u0434\u043B\u044F \u0437\u0430\u0449\u0438\u0442\u044B
    \u043E\u0442 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u043E\u0432 \u043A\u0438\u0441\u043B\u043E\u0442
    \u0438 \u0449\u0435\u043B\u043E\u0447\u0435\u0439; 3. \u0431\u0435\u043B\u044C\u0435
    \u043D\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435; 4. \u043A\u0443\u0440\u0442\u043A\u0430
    \u0434\u043B\u044F \u0437\u0430\u0449\u0438\u0442\u044B \u043E\u0442 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u043E\u0432
    \u043A\u0438\u0441\u043B\u043E\u0442 \u0438 \u0449\u0435\u043B\u043E\u0447\u0435\u0439
    \u043D\u0430 \u0443\u0442\u0435\u043F\u043B\u044F\u044E\u0449\u0435\u0439 \u043F\u0440\u043E\u043A\u043B\u0430\u0434\u043A\u0435;
    5. \u0441\u0430\u043F\u043E\u0433\u0438 \u0440\u0435\u0437\u0438\u043D\u043E\u0432\u044B\u0435
    \u0441 \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u043C \u043F\u043E\u0434\u043D\u043E\u0441\u043A\u043E\u043C;
    6. \u043F\u0435\u0440\u0447\u0430\u0442\u043A\u0438 \u043A\u0438\u0441\u043B\u043E\u0442\u043E\u0449\u0435\u043B\u043E\u0447\u0435\u0441\u0442\u043E\u0439\u043A\u0438\u0435;
    7. \u043F\u0435\u0440\u0447\u0430\u0442\u043A\u0438 \u0441 \u043F\u043E\u043B\u0438\u043C\u0435\u0440\u043D\u044B\u043C
    \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435\u043C \u0438\u043B\u0438 \u0440\u0443\u043A\u0430\u0432\u0438\u0446\u044B
    \u041A\u0420; 8. \u043F\u0435\u0440\u0447\u0430\u0442\u043A\u0438 \u0445/\u0431;
    9. \u043D\u0430\u0440\u0443\u043A\u0430\u0432\u043D\u0438\u043A\u0438 \u0445/\u0431
    \u0438\u043B\u0438 \u0445\u043B\u043E\u043F\u043A\u043E\u043B\u0430\u0432\u0441\u0430\u043D\u043E\u0432\u044B\u0435;
    10. \u043A\u0430\u0441\u043A\u0430 \u0437\u0430\u0449\u0438\u0442\u043D\u0430\u044F
    \u0441 \u043F\u043E\u0434\u0431\u043E\u0440\u043E\u0434\u043E\u0447\u043D\u044B\u043C
    \u0440\u0435\u043C\u0435\u0448\u043A\u043E\u043C; 11. \u043A\u0430\u0441\u043A\u0435\u0442\u043A\u0430
    (\u0432 \u0432\u0430\u043D\u043D\u043E\u043C \u0437\u0430\u043B\u0435, \u043F\u0440\u0438
    \u0440\u0430\u0431\u043E\u0442\u0435 \u043D\u0435 \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0445
    \u0441 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435\u043C
    \u041F\u0421); 12. \u043F\u043E\u0440\u0442\u044F\u043D\u043A\u0438 \u0441\u0443\u043A\u043E\u043D\u043D\u044B\u0435;
    13. \u043E\u0447\u043A\u0438 \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0435
    (\u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0433\u043E \u0438 \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u0433\u043E
    \u0442\u0438\u043F\u043E\u0432); 14. \u0432\u043A\u043B\u0430\u0434\u044B\u0448\u0438
    \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0448\u0443\u043C\u043D\u044B\u0435;
    15. \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u043E\u0439
    \u0437\u0430\u0449\u0438\u0442\u044B \u043E\u0440\u0433\u0430\u043D\u043E\u0432
    \u0434\u044B\u0445\u0430\u043D\u0438\u044F (\u0421\u0418\u0417\u041E\u0414) \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0430\u044D\u0440\u043E\u0437\u043E\u043B\u044C\u043D\u043E\u0435;"
  endingTime: 0
