    - target: {fileID: 4680492977577062436, guid: ca044292c12aa5e4b9e54bbd6a1cd515, type: 3}
      propertyPath: m_Text
      value: "\u041E\u0441\u043D\u043E\u0432\u043D\u044B\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u0430
