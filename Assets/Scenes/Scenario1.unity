  m_Text: "    \u0412\u043E \u0438\u0437\u0431\u0435\u0436\u0430\u043D\u0438\u0435
    \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0432\u0440\u0435\u0434\u043D\u044B\u0445
    \u0438 \u043E\u043F\u0430\u0441\u043D\u044B\u0445 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
    \u0444\u0430\u043A\u0442\u043E\u0440\u043E\u0432 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043B\u0438\u0437\u043D\u0438\u043A
    \u043E\u0431\u044F\u0437\u0430\u043D \u0431\u044B\u0442\u044C \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D
    \u0441\u043F\u0435\u0446\u043E\u0434\u0435\u0436\u0434\u043E\u0439 \u0438 \u0421\u0418\u0417
    \u0432 \u0441\u043E\u0441\u0442\u0430\u0432\u0435: \n    1. \u041A\u0430\u0441\u043A\u0430
    \u0437\u0430\u0449\u0438\u0442\u043D\u0430\u044F \u0441 \u043F\u043E\u0434\u0431\u043E\u0440\u043E\u0434\u043E\u0447\u043D\u044B\u043C
    \u0440\u0435\u043C\u0435\u0448\u043A\u043E\u043C;\r\n    2. \u041E\u0447\u043A\u0438
    \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0435 (\u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0433\u043E
    \u0442\u0438\u043F\u0430);\r\n    3. \u0421\u0440\u0435\u0434\u0441\u0442\u0432\u043E
    \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u043E\u0439
    \u0437\u0430\u0449\u0438\u0442\u044B \u043E\u0440\u0433\u0430\u043D\u043E\u0432
    \u0434\u044B\u0445\u0430\u043D\u0438\u044F (\u0421\u0418\u0417\u041E\u0414) \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0430\u044D\u0440\u043E\u0437\u043E\u043B\u044C\u043D\u043E\u0435;\r\n   
    4. \u0421\u0440\u0435\u0434\u0441\u0442\u0432\u043E \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u043E\u0439
    \u0437\u0430\u0449\u0438\u0442\u044B \u043E\u0440\u0433\u0430\u043D\u043E\u0432
    \u0434\u044B\u0445\u0430\u043D\u0438\u044F (\u0421\u0418\u0417\u041E\u0414) \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0433\u0430\u0437\u043E\u0432\u043E\u0435;\r\n   
    5. \u041F\u0440\u043E\u0442\u0438\u0432\u043E\u043A\u0438\u0441\u043B\u043E\u0442\u043D\u044B\u0435
    \u0440\u0443\u043A\u0430\u0432\u0438\u0446\u044B;\r\n    6. \u041F\u0435\u0440\u0447\u0430\u0442\u043A\u0438
    \u0441 \u043F\u043E\u043B\u0438\u043C\u0435\u0440\u043D\u044B\u043C \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435\u043C
    \u0438\u043B\u0438 \u0440\u0443\u043A\u0430\u0432\u0438\u0446\u044B \u041A\u0420;\r\n   
    7. T\u0440\u0443\u0431\u043E\u0431\u043B\u043E\u043A."
