  rulesText: "\u0416\u0438\u0432\u043E\u0442\u043D\u044B\u0435 \u0433\u0443\u043B\u044F\u043B\u0438
    \u0438 \u0438\u0441\u043F\u0430\u0447\u043A\u0430\u043B\u0438\u0441\u044C. \u0414\u0430\u0432\u0430\u0439
    \u0438\u0445 \u043F\u043E\u043C\u043E\u0435\u043C!"
  winText: "\u041C\u043E\u043B\u043E\u0434\u0435\u0446! \u0423 \u0442\u0435\u0431\u044F
    \u0432\u0441\u0451 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C.
    \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u0434\u0440\u0443\u0433\u0443\u044E
    \u0438\u0433\u0440\u0443."
  nextLevelText: "\u041C\u043E\u043B\u043E\u0434\u0435\u0446! \u0418\u0434\u0451\u043C
    \u0434\u0430\u043B\u044C\u0448\u0435."
  brushText: "\u041E, \u043E\u0442\u043B\u0438\u0447\u043D\u043E! \u0422\u0435\u043F\u0435\u0440\u044C
    \u0434\u0430\u0432\u0430\u0439 \u0449\u0451\u0442\u043A\u043E\u0439."
  showerText: "\u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u0434\u0430\u0432\u0430\u0439
