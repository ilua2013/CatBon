  lipstickProgress: 0
  faceCleaningProgressSpeed: 0.005
  creamProgressSpeed: 0.005
  eyelashesProgressSpeed: 0.005
  lipstickProgressSpeed: 0.005
  startRulesText: "\u041A\u0443\u043A\u043B\u0430\u043C \u043F\u043E\u0440\u0430
    \u043D\u0430 \u0431\u0430\u043B. \u0414\u0430\u0432\u0430\u0439 \u043F\u043E\u043C\u043E\u0436\u0435\u043C
    \u0438\u043C \u0441\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F!"
  faceCleaningText: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E\u0447\u0438\u0441\u0442\u0438\u043C
    \u043B\u0438\u0446\u043E \u0432\u0430\u0442\u043D\u044B\u043C \u0434\u0438\u0441\u043A\u043E\u043C."
  creamText: "\u0422\u0435\u043F\u0435\u0440\u044C \u0443\u0431\u0435\u0440\u0451\u043C
    \u0441\u0438\u043D\u044F\u043A\u0438 \u043F\u043E\u0434 \u0433\u043B\u0430\u0437\u0430\u043C\u0438
    \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043A\u0440\u0435\u043C\u0430."
  eyelashesText: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E! \u0422\u0435\u043F\u0435\u0440\u044C
    \u043D\u0430\u043A\u0440\u0430\u0441\u0438\u043C \u0440\u0435\u0441\u043D\u0438\u0446\u044B."
  lipstickText: "\u041E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043D\u0430\u043A\u0440\u0430\u0441\u0438\u0442\u044C
    \u0433\u0443\u0431\u044B."
  endText: "\u041C\u043E\u043B\u043E\u0434\u0435\u0446! \u0423 \u0442\u0435\u0431\u044F
    \u0432\u0441\u0451 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C.
    \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u0434\u0440\u0443\u0433\u0443\u044E
    \u0438\u0433\u0440\u0443."
  wrongItemText: "\u0421\u0435\u0439\u0447\u0430\u0441 \u043D\u0443\u0436\u0435\u043D
    \u0434\u0440\u0443\u0433\u043E\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442!"
  startRulesDelay: 4
  startAudio:
  - {fileID: 8300000, guid: 75af8e0f05fc91e4895041c3addfe4af, type: 3}
  - {fileID: 8300000, guid: dd3a543429f28334a93a154c15c04a35, type: 3}
  - {fileID: 8300000, guid: d73a76d908baae3479d8cd80b39c1ca6, type: 3}
